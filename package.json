{
  "name": "relay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "dev:ui": "bun --hot src/main.tsx",
    "build": "bun build --compile --minify --define RELAY_COMPILED=true src/main.tsx --outfile dist/relay",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:packaged": "bun run scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@gpuix/react": "^0.5.1",
    "react": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
