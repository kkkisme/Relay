{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:core && bun --hot src/main.tsx",
    "dev:ui": "bun --hot src/main.tsx",
    "build": "bun run build:core && bun run build:ui",
    "build:core": "bun build --compile src/relay-core/main.ts --outfile dist/relay-core",
    "build:ui": "bun build --compile src/main.tsx --outfile dist/relay",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gpuix/react": "^0.5.1",
    "react": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
